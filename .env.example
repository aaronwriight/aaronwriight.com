RESEND_API_KEY=re_replace_me
RESEND_SFI_SEGMENT_ID=replace-with-scope-for-imagination-segment-id
RESEND_CREATIVE_SEGMENT_ID=replace-with-creative-updates-segment-id
SFI_NEWSLETTER_FROM="Scope for Imagination <journal@updates.aaronwriight.com>"
# Optional: an inbox you read, so replies to newsletters don't bounce.
SFI_NEWSLETTER_REPLY_TO=replace-with-an-inbox-you-read
NEXT_PUBLIC_SITE_URL=https://aaronwriight.com
NEXT_PUBLIC_SANITY_PROJECT_ID=replace-with-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-02-22
# Required: the homepage loads it through src/sanity/lib/store.ts, and src/sanity/lib/token.ts throws without it.
SANITY_API_READ_TOKEN=replace-with-read-token
# Optional: only needed for `pnpm sfi:upload`.
SANITY_API_WRITE_TOKEN=replace-with-write-token
